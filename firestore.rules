rules_version = '2';

// Each user owns exactly one document plus their notes, and optionally a leaderboard entry. Everything else is denied.
//
//   users/{uid}               v, problems (map by id), days (reviews per day), topics (results per topic)
//   users/{uid}/notes/{id}    solution card: text (code), idea, time, space, mistake
//   users/{uid}/apt/{id}      aptitude question with its options, answer, explanation and schedule
//   users/{uid}/problems/{id} and /reviews/{id} — old (v1) layout: read and delete only, so the app can move it
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Shape and size limits. Firestore also caps a document at 1 MiB.
    function isValidUser(data) {
      return data.keys().hasOnly(['v', 'problems', 'days', 'topics'])
        && (!('v' in data) || data.v is int)
        && (!('problems' in data) || (data.problems is map && data.problems.size() <= 3000))
        && (!('days' in data) || (data.days is map && data.days.size() <= 4000))
        && (!('topics' in data) || (data.topics is map && data.topics.size() <= 500));
    }

    function optionalString(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() > 0 && data[key].size() <= max);
    }

    // Solution card. Limits match Limits in lib/logic/models.dart.
    function isValidNote(data) {
      return data.size() > 0
        && data.keys().hasOnly(['text', 'idea', 'time', 'space', 'mistake'])
        && optionalString(data, 'text', 20000)
        && optionalString(data, 'idea', 500)
        && optionalString(data, 'mistake', 500)
        && optionalString(data, 'time', 40)
        && optionalString(data, 'space', 40);
    }

    // Aptitude card. Limits match Limits in lib/logic/models.dart.
    function isValidApt(data) {
      return data.keys().hasOnly(['question', 'options', 'answer', 'explanation', 'topic', 'stage', 'nextDue', 'reviews', 'remembered'])
        && data.question is string && data.question.size() > 0 && data.question.size() <= 2000
        && data.options is list && data.options.size() >= 2 && data.options.size() <= 6
        && data.answer is int && data.answer >= 0 && data.answer < data.options.size()
        && data.explanation is string && data.explanation.size() <= 3000
        && data.topic is string && data.topic.size() > 0 && data.topic.size() <= 60
        && data.stage is int && data.stage >= 0 && data.stage < 20
        && data.nextDue is string && data.nextDue.size() == 10
        && data.reviews is int && data.reviews >= 0
        && data.remembered is int && data.remembered >= 0;
    }

    // Opt-in leaderboard: anyone signed in can read; you can only write your own entry, with sane values.
    // ponytail: the numbers are reported by the app, so a modified client could inflate them;
    // server-side verification needs Cloud Functions (Blaze plan).
    function isValidEntry(data) {
      return data.keys().hasOnly(['name', 'streak', 'solved', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 30
        && data.streak is int && data.streak >= 0 && data.streak <= 5000
        && data.solved is int && data.solved >= 0 && data.solved <= 5000
        && data.updatedAt == request.time;
    }

    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidEntry(request.resource.data);
    }

    match /users/{uid} {
      allow get, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidUser(request.resource.data);

      match /notes/{problemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && problemId.size() <= 64 && isValidNote(request.resource.data);
      }

      match /apt/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && id.size() <= 64 && isValidApt(request.resource.data);
      }

      match /problems/{id} {
        allow read, delete: if isOwner(uid);
      }

      match /reviews/{id} {
        allow read, delete: if isOwner(uid);
      }
    }
  }
}
