          "appId": "1:153577681363:android:6a82e0352ef267b9aeff26",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "memory-stack-e6990",
          "configurations": {
            "android": "1:153577681363:android:6a82e0352ef267b9aeff26",
            "ios": "1:153577681363:ios:ff42cfdc230f91a0aeff26",
            "web": "1:153577681363:web:e9cef817bfb9690daeff26"
          }
        }
      }
